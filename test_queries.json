{
  "info": {
    "name": "RAG Search Tests",
    "description": "Test cases for hybrid search optimization"
  },
  "tests": [
    {
      "name": "1. Biographical - Born Date",
      "endpoint": "/api/v1/nlp/index/search/project1",
      "method": "POST",
      "body": {
        "text": "Mohamed Salah born",
        "limit": 5
      },
      "expectedKeywords": ["born", "15 June", "1992"],
      "description": "Tests keyword matching for birth information"
    },
    {
      "name": "2. Career History - Teams",
      "endpoint": "/api/v1/nlp/index/search/project1",
      "method": "POST",
      "body": {
        "text": "which teams did Salah play for",
        "limit": 5
      },
      "expectedKeywords": ["Basel", "Chelsea", "Roma", "Liverpool"],
      "description": "Tests semantic understanding of career history"
    },
    {
      "name": "3. Achievement - Record Goals",
      "endpoint": "/api/v1/nlp/index/search/project1",
      "method": "POST",
      "body": {
        "text": "Salah Premier League goals record",
        "limit": 5
      },
      "expectedKeywords": ["32", "goals", "38-game", "2017-18"],
      "description": "Tests keyword matching with achievement data"
    },
    {
      "name": "4. International - Egypt Captain",
      "endpoint": "/api/v1/nlp/index/search/project1",
      "method": "POST",
      "body": {
        "text": "Egypt national team captain",
        "limit": 5
      },
      "expectedKeywords": ["Egypt", "captain", "national team"],
      "description": "Tests keyword-heavy international role"
    },
    {
      "name": "5. Event - Merseyside Derby",
      "endpoint": "/api/v1/nlp/index/search/project1",
      "method": "POST",
      "body": {
        "text": "Merseyside derby 2017-18 goal Puskas",
        "limit": 3
      },
      "expectedKeywords": ["Merseyside", "derby", "2017-18", "Puskás"],
      "description": "Tests specific event retrieval"
    },
    {
      "name": "6. Youth - Childhood Idols",
      "endpoint": "/api/v1/nlp/index/search/project1",
      "method": "POST",
      "body": {
        "text": "Tell me about Salah childhood idols Ronaldo Zidane",
        "limit": 5
      },
      "expectedKeywords": ["Ronaldo", "Zidane", "Totti", "youth"],
      "description": "Tests semantic understanding combined with keywords"
    },
    {
      "name": "7. Honors - Trophies",
      "endpoint": "/api/v1/nlp/index/search/project1",
      "method": "POST",
      "body": {
        "text": "Champions League FIFA World Cup trophies",
        "limit": 5
      },
      "expectedKeywords": ["FA Cup", "Champions League", "trophy", "title"],
      "description": "Tests semantic retrieval of achievements"
    },
    {
      "name": "8. RAG Answer - Birth Question",
      "endpoint": "/api/v1/nlp/index/answer/project1",
      "method": "POST",
      "body": {
        "text": "When was Mohamed Salah born?",
        "limit": 5
      },
      "expectedKeywords": ["1992", "June", "Egyptian"],
      "description": "Tests end-to-end RAG with question answering"
    },
    {
      "name": "9. RAG Answer - Career Question",
      "endpoint": "/api/v1/nlp/index/answer/project1",
      "method": "POST",
      "body": {
        "text": "What clubs did Salah play for before Liverpool?",
        "limit": 5
      },
      "expectedKeywords": ["Basel", "Chelsea", "Roma", "loan"],
      "description": "Tests RAG with career history"
    },
    {
      "name": "10. Re-process Data",
      "endpoint": "/api/v1/data/process-all/project1",
      "method": "POST",
      "body": {
        "chunk_size": 512,
        "overlap_size": 50,
        "do_reset": 1
      },
      "description": "RUN THIS FIRST - Re-indexes data with optimized chunk sizes"
    }
  ],
  "scoring_guide": {
    "excellent": "> 0.70 - Perfect match with keywords and semantic meaning",
    "good": "0.50-0.70 - Strong relevance, has keywords or high semantic match",
    "fair": "0.30-0.50 - Related but missing specific terms",
    "poor": "< 0.30 - Weakly related content"
  }
}
