# application information
APP_NAME="mini-RAG"
APP_VERSION="0.1"

# credentials
OPENAI_API_KEY=""

# file upload configuration
# comma-separated list of allowed extensions (without leading dots)
# either comma-separated (txt,pdf,docx), a JSON array ["txt","pdf"],
# or MIME types (e.g. "text/plain,application/pdf").  The validator lowercases
# values and the controller will match against both the file's content type
# and the file extension.
FILE_ALLOWED_TYPES=txt,pdf,docx
FILE_MAX_SIZE=10485760          # bytes (10 MB)
FILE_DEFAULT_CHUNK_SIZE=512000  # bytes (512 KB)
