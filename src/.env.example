# ==============================================================================
#                      MINI RAG APP CONFIGURATION
# ==============================================================================

# ======================== Application Info =========================
# The name of the FastApi application
APP_NAME="mini-RAG-App"
# Current build version
APP_VERSION="0.1"

# ======================== Data Ingestion & Splitting =========================
# Comma-separated list of acceptable file formats for document uploads
FILE_ALLOWED_TYPES=txt,pdf,docx,csv,md,html
# Maximum total file upload size in bytes (10 MB)
FILE_MAX_SIZE=10485760          
# Memory buffer read chunk size while loading large files (512 KB)
FILE_DEFAULT_CHUNK_SIZE=512000  
# Character limit per single text chunk fed to the embedding model
FILE_PROCESS_CHUNK_SIZE=512
# Number of overlapping characters between consecutive chunks to preserve meaning
FILE_PROCESS_OVERLAP_SIZE=50

# ======================== RAG Enhancements =========================
# Flag to enable a 2nd pass Cohere re-ranking model over search results
USE_RERANK=False
# The percentage matching threshold (0.0 to 1.0) before a Semantic Cache is considered a "Hit"
SEMANTIC_CACHE_THRESHOLD=0.95

# ── Memory Configurations ──
# Retrieves contextual PDF/TXT chunks from Vector DB (Core RAG text search)
USE_VECTOR_MEMORY=True
# Checks Vector DB for identical questions to bypass LLM generation (Cache hit)
USE_SEMANTIC_CACHE=True
# Injects the exact last N messages into the LLM payload to maintain short-term conversational flow
USE_WINDOW_MEMORY=True
# How many of the exact last chat messages to include in the Window Memory
WINDOW_MEMORY_K=5
# Auto-detects long conversations (>10 messages) and writes a rolling summary to save token space
USE_SUMMARY_MEMORY=True
# Automatically extracts important user facts/preferences to a dedicated Qdrant collection for strict semantic recall
USE_ENTITY_MEMORY=True

# ========================= MongoDB Config =========================
# Admin connection string to the MongoDB replica/node
MONGODB_URL='mongodb://admin:admin@localhost:27007/?authSource=admin'
# Name of the target MongoDB database where memories and metadata are stored
MONGODB_DATABASE=mini_rag_db

# ========================= LLM & AI Backends =========================
# Which engine to use for text embeddings (Options: "COHERE", "OPENAI", "GEMINI", "LLAMA")
EMBEDDING_BACKEND="COHERE"
# Which engine to use for the chat/conversational response
GENERATION_BACKEND="OPENAI"
# The specific text-generation model identifier (e.g. "mistral", "gpt-4", "command-r")
GENERATION_MODEL_ID="gpt-3.5-turbo-0125"

# The specific embedding model identifier
EMBEDDING_MODEL_ID="embed-multilingual-light-v3.0"
# Dimensionality of the embedding model selected above (e.g. 1536 for OpenAI, 384 for Cohere)
EMBEDDING_MODEL_SIZE=384

# Maximum characters allowed in a single payload
INPUT_DAFAULT_MAX_CHARACTERS=1024
# Default maximum tokens for generation
GENERATION_DAFAULT_MAX_TOKENS=200
# AI Creativity indicator (0.0 = strict facts, 1.0 = highly creative)
GENERATION_DAFAULT_TEMPERATURE=0.1

# ========================= API Keys & URLs =========================
# OpenAI authentication token
OPENAI_API_KEY=""
# Custom base URL for OpenAI if hosted via Azure/Enterprise
OPENAI_API_URL=""
# Cohere authentication token
COHERE_API_KEY=""

# ========================= Vector DB Config =========================
# Target database for vector storage (e.g. "QDRANT", "PINECONE","FAISS","CHROMA")
VECTOR_DB_BACKEND="QDRANT"
# Local filesystem path or network URL for the Qdrant instance
VECTOR_DB_PATH="qdrant_db"
# The mathematical formula used for matching vectors (e.g. "cosine", "dot")
VECTOR_DB_DISTANCE_METHOD="cosine"
# Pinecone specific authentication
PINECONE_API_KEY=""
# Pinecone environment cluster (e.g. "us-east-1")
PINECONE_ENV="us-east-1"

# ========================= Template Configs =========================
# The designated spoken language to route system prompts into
PRIMARY_LANG="en"
# Fallback language template to use if the primary logic fails
DEFAULT_LANG="en"