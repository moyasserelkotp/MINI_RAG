# ==============================================================================
#                      MINI RAG APP CONFIGURATION
# ==============================================================================
# This is the template configuration file for the MINI-TOURISM RAG application.
# Copy this file to .env and modify values according to your deployment needs.
# All available options are documented below.
# ==============================================================================

# ======================== APPLICATION INFORMATION ==========================
# The name of the FastAPI application
APP_NAME="mini-RAG-App"
# Current build version
APP_VERSION="0.1"

# Enable/disable debug mode (shows detailed error messages and stack traces)
# Options: True (development), False (production)
# WARNING: Never use True in production - exposes sensitive information
DEBUG=False

# Logging level (controls verbosity of application logs)
# Options: DEBUG (most verbose, development), INFO (normal), WARNING, ERROR (least verbose)
# DEBUG: Log everything including detailed information
# INFO: Log general information and events
# WARNING: Log warnings and errors only
# ERROR: Log errors only
LOG_LEVEL=INFO

# ======================== FILE UPLOAD & PROCESSING ==========================
# Comma-separated list of allowed file formats for document uploads
# Available options: txt, pdf, docx, doc, csv, md, html
# Examples:
#   - All formats: txt,pdf,docx,doc,csv,md,html
#   - Text only: txt,md,csv
#   - Documents only: pdf,docx,doc
FILE_ALLOWED_TYPES=txt,pdf,docx,csv,md,html

# Maximum file upload size in bytes (default: 10 MB = 10485760 bytes)
# Examples:
#   - 5 MB:  5242880
#   - 10 MB: 10485760
#   - 50 MB: 52428800
FILE_MAX_SIZE=10485760          

# Chunk size for reading large files into memory (bytes, default: 512 KB)
# Used for streaming reads to avoid loading entire file at once
FILE_DEFAULT_CHUNK_SIZE=512000  

# Number of tokens/characters per chunk during text processing (default: 512)
# Smaller values = shorter chunks (more detailed, slower)
# Larger values = longer chunks (less detailed, faster)
FILE_PROCESS_CHUNK_SIZE=512

# Number of overlapping characters between consecutive chunks (default: 50)
# Prevents losing context at chunk boundaries
# Higher values = more overlap = better context preservation but more tokens used
FILE_PROCESS_OVERLAP_SIZE=50

# Text chunking strategy (options below)
# Available strategies:
#   - fixed: Fixed-size chunks with configured overlap
#   - overlapping: Alias for fixed-size with overlap
#   - recursive: Recursively split by paragraphs/sentences (best for quality)
#   - semantic: Semantic-aware splitting (requires additional setup)
#   - document_structure: Preserve document structure (headers, sections)
#   - sentence_based: Split strictly by sentence boundaries
# CHUNK_STRATEGY=overlapping


# ======================== RAG ENHANCEMENT FEATURES ==========================
# Enable reranking to improve search result relevance
# If enabled, uses Cohere's reranking model as a 2nd pass over initial search results
# Options: True (enable), False (disable)
USE_RERANK=False

# Semantic cache similarity threshold (0.0 to 1.0, default: 0.95)
# When a new question matches cached questions above this threshold, return cached response
# Range explanation:
#   - 0.95: Very strict matching (only near-identical questions hit cache)
#   - 0.8-0.9: Balanced (similar questions hit cache)
#   - 0.5-0.7: Permissive (many similar questions share cache)
#   - Lower = more cache hits but potentially less accurate responses
SEMANTIC_CACHE_THRESHOLD=0.95

# ======================== RAG MEMORY CONFIGURATIONS ==========================
# Use vector memory: Retrieve relevant document chunks from Vector DB
# Core RAG component - searches knowledge base for relevant information
# Options: True (retrieve chunks), False (no vector search)
USE_VECTOR_MEMORY=True

# Use semantic cache: Cache responses for identical/similar questions
# Returns cached response if similar question was asked before
# Improves response time and reduces LLM API calls
# Options: True (enable caching), False (no caching)
USE_SEMANTIC_CACHE=True

# Use window memory: Include recent conversation history in context
# Helps LLM maintain conversation context by including last N messages
# Options: True (include recent messages), False (no conversation history)
USE_WINDOW_MEMORY=True

# Number of recent messages to include in window memory (default: 5)
# Higher values preserve more context but use more tokens and increase latency
# Examples:
#   - 3: Only last 3 messages (smaller context, faster)
#   - 5: Last 5 messages (balanced)
#   - 10: Last 10 messages (more context, slower, more tokens)
WINDOW_MEMORY_K=5

# Use summary memory: Auto-summarize long conversations
# When conversation exceeds ~10 messages, creates rolling summary to save tokens
# Prevents context window overflow in long sessions
# Options: True (auto-summarize), False (keep all messages)
USE_SUMMARY_MEMORY=True

# Use entity memory: Extract and store important entities/facts
# Automatically detects user facts, preferences, entities for semantic recall
# Stores entities in dedicated Qdrant collection for strict semantic matching
# Options: True (track entities), False (no entity extraction)
USE_ENTITY_MEMORY=True


# ======================== MONGODB CONFIGURATION =============================
# MongoDB connection string with authentication
# Format: mongodb://[username]:[password]@[host]:[port]/?authSource=[authDB]
# Examples:
#   - Local MongoDB:
#     mongodb://admin:admin@localhost:27017/?authSource=admin
#   - MongoDB with replica set:
#     mongodb://admin:admin@localhost:27017,localhost:27018/?authSource=admin&replicaSet=rs0
#   - MongoDB Atlas (cloud):
#     mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
#   - Remote MongoDB:
#     mongodb://admin:password@your-host:27017/?authSource=admin
MONGODB_URL='mongodb://admin:admin@localhost:27007/?authSource=admin'

# MongoDB database name where all collections are stored
# Available collections (auto-created):
#   - projects: RAG project metadata
#   - chunks: Processed text chunks from documents
#   - assets: Uploaded documents/files
#   - chat_sessions: User conversation sessions
#   - chat_messages: Individual chat messages within sessions
MONGODB_DATABASE=mini_rag_db


# ======================== LLM & AI BACKENDS ===================================
# Which embedding provider to use for converting text to vectors
# Available backends:
#   - COHERE: Cohere API (cloud-hosted, paid)
#   - OPENAI: OpenAI API (cloud-hosted, paid)
#   - GEMINI: Google Gemini API (cloud-hosted, paid)
#   - HUGGINGFACE: Hugging Face models (cloud or local)
#   - LLAMA: Local Llama models via Ollama (local, free)
EMBEDDING_BACKEND="COHERE"

# Which LLM provider to use for chat/response generation
# Available backends:
#   - COHERE: Cohere API (cloud-hosted, paid)
#   - OPENAI: OpenAI API (cloud-hosted, paid, recommended)
#   - GEMINI: Google Gemini API (cloud-hosted, paid)
#   - HUGGINGFACE: Hugging Face models (cloud or local)
#   - LLAMA: Local Llama models via Ollama (local, free)
GENERATION_BACKEND="OPENAI"

# The specific model ID for text generation
# Examples by backend:
#   - OpenAI: gpt-4, gpt-4-turbo, gpt-3.5-turbo, gpt-3.5-turbo-0125
#   - Cohere: command-r-plus, command-r, command-a-03-2025, command-light
#   - Gemini: gemini-pro, gemini-pro-vision
#   - Llama (via Ollama): mistral, llama2, neural-chat, dolphin-mixtral
#   - Hugging Face: meta-llama/Llama-2-7b-hf, mistralai/Mistral-7B
GENERATION_MODEL_ID="gpt-3.5-turbo-0125"

# The specific model ID for text embeddings
# Examples by backend:
#   - OpenAI: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
#   - Cohere: embed-english-v3.0, embed-english-light-v3.0, embed-multilingual-v3.0
#   - Hugging Face: sentence-transformers/all-MiniLM-L6-v2, sentence-transformers/all-mpnet-base-v2
#   - Llama: nomic-embed-text (via Ollama)
EMBEDDING_MODEL_ID="embed-multilingual-light-v3.0"

# Vector dimension of the embedding model (must match the model)
# Different models have different dimensions:
#   - OpenAI text-embedding-3-small: 1536
#   - OpenAI text-embedding-3-large: 3072
#   - Cohere embed-english-v3.0: 1024
#   - Cohere embed-english-light-v3.0: 384
#   - Hugging Face MiniLM: 384
#   - Hugging Face MPNet: 768
EMBEDDING_MODEL_SIZE=384

# Maximum characters allowed in a single input query
# Queries longer than this will be truncated
# Examples:
#   - 512: Very short queries only
#   - 1024: Short to medium queries
#   - 4096: Medium to long queries
#   - 16384: Very long queries
INPUT_DAFAULT_MAX_CHARACTERS=1024

# Maximum tokens to generate in each LLM response
# Lower values = shorter, faster responses
# Higher values = longer, more detailed responses
# Examples:
#   - 200: Brief responses
#   - 512: Medium-length responses (balanced)
#   - 1000: Long, detailed responses
#   - 2048: Very long responses
GENERATION_DAFAULT_MAX_TOKENS=200

# Temperature for text generation (creativity level, 0.0 to 1.0+)
# Lower = more deterministic/factual, Higher = more creative/random
# Examples:
#   - 0.0: Deterministic (always same answer, best for factual responses)
#   - 0.1-0.3: Low randomness (good for factual Q&A, recommended for RAG)
#   - 0.5-0.7: Balanced randomness
#   - 0.9+: High randomness (creative, may be inaccurate)
GENERATION_DAFAULT_TEMPERATURE=0.1

# ======================== API KEYS & CREDENTIALS ==============================
# OpenAI API authentication token
# Get from: https://platform.openai.com/api-keys
# Required if EMBEDDING_BACKEND or GENERATION_BACKEND is "OPENAI"
OPENAI_API_KEY=""

# Optional: Custom OpenAI API base URL
# Use for Azure OpenAI or self-hosted OpenAI-compatible servers
# Example: https://your-instance.openai.azure.com/
# Leave blank for standard OpenAI API
OPENAI_API_URL=""

# Cohere API authentication token
# Get from: https://dashboard.cohere.com/api-keys
# Required if EMBEDDING_BACKEND or GENERATION_BACKEND is "COHERE"
COHERE_API_KEY=""

# Hugging Face API authentication token
# Get from: https://huggingface.co/settings/tokens
# Required if using Hugging Face models
HUGGINGFACE_API_KEY=""

# Llama/Ollama local server configuration
# API key (usually not needed for local Ollama)
LLAMA_API_KEY=""
# URL to your local Ollama instance
# Default: http://localhost:11434 or http://172.21.16.1:11434 for Docker
# LLAMA_API_URL="http://172.21.16.1:11434"

# Google Gemini API authentication token
# Get from: https://makersuite.google.com/app/apikey
# Required if using Gemini backend
GEMINI_API_KEY=""

# ======================== VECTOR DATABASE CONFIGURATION ======================
# Which vector database backend to use for storing and retrieving embeddings
# Available backends:
#   - QDRANT: High-performance vector DB (recommended, self-hosted)
#            Fast, open-source, supports filtering, great for production
#   - FAISS: Facebook AI Similarity Search (lightweight, local-only)
#           Good for smaller datasets, no network overhead
#   - CHROMA: Lightweight open-source vector DB
#            Simple setup, good for development/prototyping
#   - PINECONE: Managed cloud vector database
#              Fully managed service, no infrastructure management
VECTOR_DB_BACKEND="QDRANT"

# Connection path or URL for the vector database
# Usage by backend:
#   - QDRANT (local): qdrant_db (local directory)
#   - QDRANT (remote): http://your-host:6333 or https://your-host:6333
#   - FAISS: path/to/faiss_index (local directory)
#   - CHROMA: ./chroma_db (local directory)
#   - PINECONE: (not used, configure via API key instead)
VECTOR_DB_PATH="qdrant_db"

# Vector similarity distance metric for search
# Different metrics work better for different scenarios
# Available options:
#   - cosine: Cosine similarity (most common, recommended for most use cases)
#            Works well with normalized embeddings
#   - dot: Dot product (faster, less stable, needs careful scaling)
#         Good for high-dimensional sparse vectors
#   - euclidean: Euclidean distance (traditional metric)
#               Good for geometric interpretation but slower than cosine
VECTOR_DB_DISTANCE_METHOD="cosine"

# Prefix for auto-generated vector collection names
# Collections are created as: {prefix}_{id}
# Example: collection_1, collection_2, etc.
VECTOR_DB_COLLECTION_PREFIX="collection"

# ======================== PINECONE CONFIGURATION (if using Pinecone) ==========
# Pinecone API authentication key
# Get from: https://app.pinecone.io/
# Required only if VECTOR_DB_BACKEND is "PINECONE"
PINECONE_API_KEY=""

# Pinecone environment/region
# Examples: us-east-1, us-west-2, eu-west-1, asia-northeast1-gcp
# Get from your Pinecone project dashboard
PINECONE_ENV="us-east-1"

# ======================== VECTOR DB TUNING PARAMETERS =======================
# Maximum number of embeddings to process in a single batch
# Higher values = faster processing but more memory usage
# Examples:
#   - 32: Conservative (low memory, slower)
#   - 96: Balanced (default, recommended)
#   - 256: Aggressive (high memory, faster)
# Adjust based on available GPU/CPU memory
MAX_EMBEDDING_BATCH_SIZE=96

# Minimum relevance score threshold for search results (0.0 to 1.0)
# Search results below this score will be filtered out
# Examples:
#   - 0.0: No filtering, include all results (default)
#   - 0.3: Filter very low relevance results
#   - 0.5: Only include moderately relevant results
#   - 0.7: Only include high relevance results
# Useful to reduce noise and improve answer quality
SEARCH_SCORE_THRESHOLD=0.0


# ======================== LANGUAGE & LOCALIZATION ==============================
# Primary language for the application
# Available languages:
#   - en: English
#   - ar: Arabic
# Used for routing system prompts and template localization
PRIMARY_LANG="en"

# Fallback language if primary language template is not available
# Available languages: en (English), ar (Arabic)
# Used when PRIMARY_LANG template is missing
DEFAULT_LANG="en"

# ==============================================================================
# CONFIGURATION SUMMARY & QUICK START GUIDE
# ==============================================================================
# 
# MINIMAL SETUP (Local Development with Cohere):
#   1. Set EMBEDDING_BACKEND="COHERE"
#   2. Set GENERATION_BACKEND="COHERE"
#   3. Set COHERE_API_KEY with your token
#   4. Keep VECTOR_DB_BACKEND="QDRANT"
#   5. Keep MongoDB local
#
# OPENAI SETUP (Recommended for Production):
#   1. Set EMBEDDING_BACKEND="OPENAI"
#   2. Set GENERATION_BACKEND="OPENAI"
#   3. Set OPENAI_API_KEY with your token
#   4. Set GENERATION_MODEL_ID="gpt-4" or "gpt-3.5-turbo"
#   5. Set EMBEDDING_MODEL_ID="text-embedding-3-small"
#   6. Set EMBEDDING_MODEL_SIZE=1536
#   7. Set VECTOR_DB_BACKEND="QDRANT" (or "PINECONE" for cloud)
#
# LOCAL-ONLY SETUP (No API Keys Required):
#   1. Set EMBEDDING_BACKEND="LLAMA"
#   2. Set GENERATION_BACKEND="LLAMA"
#   3. Set LLAMA_API_URL to your local Ollama instance
#   4. Set EMBEDDING_MODEL_ID="nomic-embed-text"
#   5. Set GENERATION_MODEL_ID="mistral" or "llama2"
#   6. Keep VECTOR_DB_BACKEND="QDRANT" (local)
#
# PINECONE + OPENAI SETUP (Fully Managed Cloud):
#   1. Set EMBEDDING_BACKEND="OPENAI"
#   2. Set GENERATION_BACKEND="OPENAI"
#   3. Set VECTOR_DB_BACKEND="PINECONE"
#   4. Set PINECONE_API_KEY and PINECONE_ENV
#   5. Set OPENAI_API_KEY
#
# ==============================================================================