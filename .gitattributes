# MNT-03: Normalize line endings across the repository.
# Enforces LF on checkout for all text files to prevent CRLF contamination
# when Windows contributors push files. The CRLF in existing Python files was
# noted in the audit; this prevents it from spreading.

# Default: normalize everything to LF on checkin
* text=auto eol=lf

# Python source
*.py    text eol=lf
*.pyi   text eol=lf

# Config / data files
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.env   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.rst   text eol=lf
*.sh    text eol=lf

# Docker
Dockerfile  text eol=lf
*.dockerfile text eol=lf

# Nginx / Prometheus configs
*.conf  text eol=lf

# Windows scripts keep CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary files — no normalization
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.tar   binary
